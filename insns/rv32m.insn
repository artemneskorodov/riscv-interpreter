mul:
    x[rd] = mul(x[rs1], x[rs2])
    pc = pc + 4

mulh:
    x[rd] = mulh(x[rs1], x[rs2])
    pc = pc + 4

mulhsu:
    x[rd] = mulhsu(x[rs1], x[rs2])
    pc = pc + 4

mulhu:
    x[rd] = mulhu(x[rs1], x[rs2])
    pc = pc + 4

div:
    if x[rs2] == 0:
        x[rd] = -1
    elif x[rs1] == 0x80000000 and x[rs2] == 0xffffffff:
        x[rd] = 0x80000000
    else:
        x[rd] = signed(x[rs1]) // signed(x[rs2])
    pc = pc + 4

divu:
    if x[rs2] == 0:
        x[rd] = 0xffffffff
    else:
        x[rd] = x[rs1] // x[rs2]
    pc = pc + 4

rem:
    if x[rs2] == 0:
        x[rd] = x[rs1]
    elif x[rs1] == 0x80000000 and x[rs2] == 0xffffffff:
        x[rd] = 0
    else:
        x[rd] = signed(x[rs1]) % signed(x[rs2])
    pc = pc + 4

remu:
    if x[rs2] == 0:
        x[rd] = x[rs1]
    else:
        x[rd] = x[rs1] % x[rs2]
    pc = pc + 4
