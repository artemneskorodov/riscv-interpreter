add:
    x[rd] = x[rs1] + x[rs2]

addi:
    x[rd] = x[rs1] + sx(immI)

and:
    x[rd] = x[rs1] & x[rs2]

andi:
    x[rd] = x[rs1] & sx(immI)

auipc:
    x[rd] = pc + sx(immU)

beq:
bge:
bgeu:
blt:
bltu:
bne:
ebreak:
ecall:
fence:
jal:
jalr:
lb:
lbu:
    x[rd] = mem8[x[rs1] + sx(immI)]

lh:
lhu:
lui:
lw:
or:
ori:
pause:
